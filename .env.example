# Pagewoga Backend Production Environment Variables
# This file documents all required and optional environment variables.
# NEVER commit actual secret values to this file or any .env file.
# In production, secrets must be obtained from AWS Secrets Manager or provided by the deployment system.

# ════════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# Application port. In production, this should be the internal port (e.g., 3000).
# Nginx/reverse proxy will expose the HTTPS endpoint on port 443.
PORT=3000

# Node environment. Set to "production" for EC2 deployment.
# When NODE_ENV=production:
# - Secrets Manager integration is enabled
# - SESSION secure flag is enabled
# - Scheduler is enabled
# - Logging is in production format
NODE_ENV=production

# AWS region for Secrets Manager and S3
AWS_REGION=ap-south-1

# Optional: name of the secret in AWS Secrets Manager containing database credentials
# Default: "pagewoga/prod/database"
# In production, the EC2 IAM role must have permission to read this secret.
# DATABASE_SECRET_NAME=pagewoga/prod/database

# ════════════════════════════════════════════════════════════════════════════════
# DATABASE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# DATABASE_URL: PostgreSQL connection string
# In production: This is loaded from AWS Secrets Manager. Do NOT set this manually.
# In development: Set this in your local .env file or shell environment.
# Example for development: postgresql://user:password@localhost:5432/pagewoga
# Example for RDS: postgresql://postgres:password@pagewoga-db.cvm6yc6wit1b.ap-south-1.rds.amazonaws.com:5432/pagewoga-db
# 
# IMPORTANT: Never commit actual DATABASE_URL with real passwords to this repository.
DATABASE_URL=

# ════════════════════════════════════════════════════════════════════════════════
# CORS CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# Comma-separated list of allowed CORS origins
# Example: https://pagewoga.online,https://admin.pagewoga.online,https://host.pagewoga.online
# If not set, CORS allows all origins (not recommended for production)
CORS_ORIGINS=

# ════════════════════════════════════════════════════════════════════════════════
# BANKING & ENCRYPTION
# ════════════════════════════════════════════════════════════════════════════════

# Encryption key for bank account numbers (stored in hex format, 32 bytes = 64 hex characters)
# This key is used to encrypt sensitive bank account information at rest.
# Must be exactly 64 hexadecimal characters (32 bytes).
# Example (DO NOT USE): 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BANK_ACCOUNT_ENCRYPTION_KEY=

# ════════════════════════════════════════════════════════════════════════════════
# PAYU PAYMENT GATEWAY
# ════════════════════════════════════════════════════════════════════════════════

# PayU API key for deposits
PAYU_KEY=

# PayU API salt/passphrase for deposits
PAYU_SALT=

# PayU success callback URL (where PayU redirects after successful payment)
# Must use HTTPS in production
# Example: https://pagewoga.online/api/deposits/payu-success
PAYU_SURL=

# PayU failure callback URL (where PayU redirects after failed payment)
# Must use HTTPS in production
# Example: https://pagewoga.online/api/deposits/payu-failure
PAYU_FURL=

# PayU environment: "test" or "production"
# Use "test" for development/staging with PayU's test gateway
# Use "production" for live payment processing (uses real money)
PAYU_ENV=test

# ════════════════════════════════════════════════════════════════════════════════
# PAYU PAYOUT GATEWAY (Withdrawals)
# ════════════════════════════════════════════════════════════════════════════════

# PayU API key for payouts (user withdrawals)
PAYU_PAYOUT_KEY=

# PayU API salt/passphrase for payouts
PAYU_PAYOUT_SALT=

# PayU payout environment: "test" or "production"
# Use "test" for development/staging
# Use "production" for live payout processing
PAYU_PAYOUT_ENV=test

# Payout provider: "payu" or other providers (if implemented)
# Default: "payu"
PAYOUT_PROVIDER=payu

# ════════════════════════════════════════════════════════════════════════════════
# AWS S3 CONFIGURATION (File Storage)
# ════════════════════════════════════════════════════════════════════════════════

# S3 bucket name for storing uploaded files (competition screenshots, etc.)
# The EC2 IAM role must have permission to read/write to this bucket
# Example: pagewoga-uploads
S3_BUCKET=

# ════════════════════════════════════════════════════════════════════════════════
# PUSH NOTIFICATIONS
# ════════════════════════════════════════════════════════════════════════════════

# Push notification provider endpoint URL
# Used for sending real-time notifications to mobile apps
PUSH_PROVIDER_URL=

# ════════════════════════════════════════════════════════════════════════════════
# FIREBASE (Phone Verification)
# ════════════════════════════════════════════════════════════════════════════════

# Firebase project ID for phone OTP verification
# Used with Firebase Authentication for mobile phone verification
FIREBASE_PROJECT_ID=

# ════════════════════════════════════════════════════════════════════════════════
# SCHEDULER CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════

# Health check interval for withdrawal monitoring (milliseconds)
# Default: 600000 (10 minutes)
# The health check monitors for reserved_balance drift and stuck withdrawals
HEALTH_CHECK_INTERVAL_MS=600000

# Deposit reconciliation job interval (milliseconds)
# Default: 300000 (5 minutes)
# Polls PayU for pending deposits that have been waiting longer than the staleness threshold
DEPOSIT_RECONCILIATION_JOB_INTERVAL_MS=300000

# Competition scheduler interval (milliseconds)
# Default: 30000 (30 seconds)
# Keeps competition lifecycle state current
COMPETITION_JOB_INTERVAL_MS=30000

# ════════════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ════════════════════════════════════════════════════════════════════════════════

# Maximum withdrawal requests per user per day
# Default: 10
WITHDRAWAL_RATE_LIMIT_MAX=10

# ════════════════════════════════════════════════════════════════════════════════
# SECURITY & SESSION
# ════════════════════════════════════════════════════════════════════════════════

# Note: Session security is configured in code based on NODE_ENV
# - Development: insecure cookies (HTTP allowed)
# - Production: secure cookies (HTTPS only)
# No additional configuration needed unless custom session settings are required
